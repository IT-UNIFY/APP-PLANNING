{
  "name": "app-planning",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Outil Planning de l'ERP EPSS — lot 1 : consultation des séances importées d'Aurion.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:preprod": "tsc -b && vite build --mode preprod",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run lint && npm run typecheck && npm run socle:verifier && npm test && npm run check:edge && npm run test:edge && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen:db-types": "dotenv -e .env -- npx supabase gen types typescript --project-id A-RENSEIGNER > src/types/database.ts",
    "prepare": "git config core.hooksPath .githooks || echo 'ATTENTION: porte pre-push NON activee -- lancer: git config core.hooksPath .githooks'",
    "check:edge": "node scripts/check-edge-types.mjs",
    "test:edge": "node scripts/test-edge.mjs",
    "socle:verifier": "node scripts/vendorer-socle.mjs",
    "socle:sync": "node scripts/vendorer-socle.mjs --synchroniser",
    "socle:amont": "node scripts/vendorer-socle.mjs --comparer-amont",
    "deploy:edge": "node scripts/deploy-edge.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.5.4",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^15.9.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.3.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
