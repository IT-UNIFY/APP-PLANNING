{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run dev)",
      "Bash(npm run build)",
      "Bash(npm run build:preprod)",
      "Bash(npm run preview)",
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm test)",
      "Bash(npm run verify)",
      "Bash(npx vite *)",
      "Bash(npx tsc *)",
      "Bash(npx eslint *)",
      "Bash(npx supabase secrets list)",
      "Bash(npx supabase db diff *)",
      "Bash(npx supabase db lint)",
      "Bash(npx supabase functions list)",
      "Bash(npx supabase functions download *)",
      "Bash(npx supabase migration list)",
      "Bash(npx supabase migration new *)",
      "Bash(git add *)",
      "Bash(git commit -m ' *)",
      "Bash(cat eslint.config.*)",
      "Bash(cat tailwind.config.*)",
      "Bash(cat postcss.config.*)",
      "Bash(cat vite.config.*)",
      "Bash(cat tsconfig*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "echo '{\"systemMessage\": \"README drift check: structure du projet, roles, fonctionnalites, scripts disponibles, variables d environnement. Exempt: pure internal refactors.\"}'"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/timelog-shim.mjs\" timelog-capture"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/timelog-shim.mjs\" timelog-capture"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/timelog-shim.mjs\" timelog-capture"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/timelog-shim.mjs\" timelog-capture"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/timelog-shim.mjs\" timelog-check",
            "statusMessage": "Vérification du TIMELOG…"
          }
        ]
      }
    ]
  }
}
